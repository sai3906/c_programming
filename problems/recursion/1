#include<stdio.h>
int arr_rev(int a[],int );
int main(){
  int a[]={1,2,3,4,5,6};
  /*
  int a[] = int *a
  this pointer points to a[0] 
  */
  int len = sizeof(a)/sizeof(a[1]);
  arr_rev(a,len);
}
int arr_rev(int *b,int len){
  printf("len of b=%d\n",len);
  for(int i=0;i<len;i++){
    printf("%d ",b[i]);
  }
  int j=0;
  int rev[len];
  if(j<len){
    rev[len-j]=b[j];
    printf("%d ",rev[j]);
  }
  printf("\n");
  for(int i=0;i<len;i++){
    printf("%d ",rev[i]);
  }
  printf("\n");
}
